{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhisperNow",
  "identifier": "com.whispernow.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "dx serve --platform web --port 1420 --open false --features dev --locked",
      "cwd": "../ui"
    },
    "beforeBuildCommand": {
      "script": "dx build --platform web --release --locked",
      "cwd": "../ui"
    },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../target/dx/whispernow-ui/release/web/public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "WhisperNow",
        "url": "/?window=settings",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "transparent": true
      },
      {
        "label": "recording-bar",
        "title": "WhisperNow Recording Status",
        "url": "/?window=recording-bar",
        "width": 360,
        "height": 132,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "focusable": false,
        "acceptFirstMouse": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; media-src 'self' blob:; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "WhisperNow contributors",
    "homepage": "https://github.com/stephan271c/WhisperNow",
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "resources": {
      "../../LICENSE": "licenses/LICENSE",
      "../../release/NATIVE_DEPENDENCIES.md": "licenses/NATIVE_DEPENDENCIES.md",
      "../../resources/vad/LICENSE-MIT": "vad/LICENSE-MIT",
      "../../resources/vad/manifest.json": "vad/manifest.json",
      "../../resources/vad/silero_vad.onnx": "vad/silero_vad.onnx"
    },
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "category": "Productivity",
    "shortDescription": "Private local-first desktop dictation",
    "longDescription": "WhisperNow records push-to-talk audio, detects meaningful speech with a bundled offline VAD model, transcribes it locally, and safely returns text to the intended application. User-selected ASR models are downloaded on demand and are not included in the installer."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/stephan271c/WhisperNow/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
