{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Typed application commands for the settings webview, plus the window operations its titlebar runs",
  "windows": ["settings"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-is-decorated",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "allow-get-settings",
    "allow-update-settings",
    "allow-set-start-on-login",
    "allow-set-api-key",
    "allow-clear-api-key",
    "allow-list-provider-models",
    "allow-list-audio-devices",
    "allow-test-microphone",
    "allow-list-models",
    "allow-download-model",
    "allow-cancel-download",
    "allow-select-model",
    "allow-delete-model",
    "allow-save-setup-checkpoint",
    "allow-complete-setup",
    "allow-restart-setup",
    "allow-get-permissions",
    "allow-request-permission",
    "allow-open-permission-settings",
    "allow-set-up-paste-helper",
    "allow-start-test-dictation",
    "allow-stop-recording",
    "allow-cancel-recording",
    "allow-dismiss-recording-overlay",
    "allow-copy-text",
    "allow-open-main-window",
    "allow-get-state",
    "allow-get-history",
    "allow-get-history-audio",
    "allow-open-recordings-folder",
    "allow-delete-history-entry",
    "allow-clear-history",
    "allow-data-locations",
    "allow-clear-data",
    "allow-suspend-shortcuts",
    "allow-resume-shortcuts",
    "allow-get-update-state",
    "allow-check-for-updates",
    "allow-dismiss-update",
    "allow-restart-to-update",
    "allow-open-update-release-page"
  ]
}
