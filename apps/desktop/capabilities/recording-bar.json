{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "recording-bar",
  "description": "State and event access for the non-focusable recording bar, plus the commands its controls run",
  "windows": ["recording-bar"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-state",
    "allow-stop-recording",
    "allow-cancel-recording",
    "allow-dismiss-recording-overlay",
    "allow-open-main-window",
    "allow-open-permission-settings"
  ]
}
