+// draft_text request field: the words of a per-request text (for an editing task, the input as code
+// can clean it), matched against the words generated so far ignoring case and punctuation; the words
+// after the match are the draft. The pointer is only the last match: each pass re-derives it from the
+// output, so a rejected draft needs no undo.
+struct server_text_draft {
+    std::vector<std::string> words;
+    std::vector<std::string> keys;
+    size_t pointer = 0;
+
+    static std::string norm(const std::string & w) {
+        std::string out;
+        for (unsigned char c : w) {
+            if (std::isalnum(c) || c == '_' || c >= 0x80) {
+                out += (char) std::tolower(c);
+            }
+        }
+        return out;
+    }
+
+    static std::vector<std::string> split(const std::string & s) {
+        std::vector<std::string> out;
+        std::string cur;
+        for (char c : s) {
+            if (std::isspace((unsigned char) c)) {
+                if (!cur.empty()) {
+                    out.push_back(cur);
+                    cur.clear();
+                }
+            } else {
+                cur += c;
+            }
+        }
+        if (!cur.empty()) {
+            out.push_back(cur);
+        }
+        return out;
+    }
+
+    static std::string lower(const std::string & s) {
+        std::string out = s;
+        for (auto & c : out) {
+            c = (char) std::tolower((unsigned char) c);
+        }
+        return out;
+    }
+
+    void init(const std::string & text) {
+        words = split(text);
+        keys.clear();
+        for (const auto & w : words) {
+            keys.push_back(norm(w));
+        }
+        pointer = 0;
+    }
+
+    bool empty() const { return words.empty(); }
+
+    // keys[p, p + n) equal the last n of k
+    bool match(const std::vector<std::string> & k, size_t p, size_t n) const {
+        for (size_t j = 0; j < n; ++j) {
+            if (keys[p + j] != k[k.size() - n + j]) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    long nearest(const std::vector<std::string> & k, size_t n, size_t lo, size_t hi) const {
+        long best = -1;
+        for (size_t p = lo; p + n <= hi; ++p) {
+            if (match(k, p, n)) {
+                const auto d  = p > pointer ? p - pointer : pointer - p;
+                const auto db = (size_t) best > pointer ? (size_t) best - pointer : pointer - (size_t) best;
+                if (best < 0 || d < db) {
+                    best = (long) p;
+                }
+            }
+        }
+        return best;
+    }
+
+    // position after the match of the last words of k, or -1
+    long find(const std::vector<std::string> & k) const {
+        for (size_t n : {3, 2, 1}) {
+            if (k.size() < n) {
+                continue;
+            }
+            const size_t lo = pointer > 8 ? pointer - 8 : 0;
+            const size_t hi = std::min(keys.size(), pointer + 60);
+            const long p = nearest(k, n, lo, hi);
+            if (p >= 0) {
+                return p + (long) n;
+            }
+        }
+        // lost: the whole text, on two or more words, nearest the pointer
+        for (size_t n : {3, 2}) {
+            if (k.size() < n) {
+                continue;
+            }
+            const long p = nearest(k, n, 0, keys.size());
+            if (p >= 0) {
+                return p + (long) n;
+            }
+        }
+        return -1;
+    }
+
+    std::string join(size_t from, size_t to, bool lead) const {
+        std::string out;
+        for (size_t i = from; i < std::min(to, words.size()); ++i) {
+            if (lead || i > from) {
+                out += ' ';
+            }
+            out += words[i];
+        }
+        return out;
+    }
+
+    // the draft text to follow `text`, or "" when there is none
+    std::string draft(const std::string & text) {
+        if (text.empty()) {
+            return join(0, words.size(), false);
+        }
+        const auto parts = split(text);
+        if (parts.empty()) {
+            return "";
+        }
+        std::vector<std::string> k;
+        for (const auto & p : parts) {
+            auto n = norm(p);
+            if (!n.empty()) {
+                k.push_back(std::move(n));
+            }
+        }
+        // the last word taken as complete: draft the words after it
+        long pos = find(k);
+        if (pos >= 0 && (size_t) pos < words.size()) {
+            pointer = pos;
+            std::string rest = join(pos, pos + 24, false);
+            if (std::strchr(".?!:", parts.back().back()) && !rest.empty()) {
+                rest[0] = (char) std::toupper((unsigned char) rest[0]);
+            }
+            const bool ws = text.back() == ' ' || text.back() == '\n';
+            return (ws ? "" : " ") + rest;
+        }
+        // the last word unfinished: complete it from the next word
+        if (std::isalnum((unsigned char) text.back()) && k.size() > 1) {
+            std::vector<std::string> k2(k.begin(), k.end() - 1);
+            pos = find(k2);
+            if (pos >= 0 && (size_t) pos < words.size()) {
+                pointer = pos;
+                const auto & word = words[pos];
+                const auto & last = parts.back();
+                if (word.size() > last.size() && lower(word).rfind(lower(last), 0) == 0) {
+                    return word.substr(last.size()) + join(pos + 1, pos + 24, true);
+                }
+            }
+        }
+        return "";
+    }
+};
